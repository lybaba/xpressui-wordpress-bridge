{
  "name": "@lybaba/xpressui",
  "version": "1.0.16",
  "repository": "https://github.com/lybaba/xpressui",
  "description": "Schema-driven web components for forms and post UIs",
  "main": "./lib/index.js",
  "module": "./dist/xpressui.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/xpressui.mjs",
      "require": "./lib/index.js",
      "default": "./dist/xpressui.mjs"
    },
    "./advanced": {
      "types": "./lib/advanced.d.ts",
      "require": "./lib/advanced.js",
      "default": "./lib/advanced.js"
    },
    "./integrations": {
      "types": "./lib/integrations.d.ts",
      "require": "./lib/integrations.js",
      "default": "./lib/integrations.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "/lib",
    "/dist"
  ],
  "scripts": {
    "build:dist:light": "node -e \"process.env.XPRESSUI_RUNTIME_TIER='light'; require('child_process').execSync('vite build --sourcemap', {stdio: 'inherit'})\"",
    "build": "npm run build:dist:light",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.18.0",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "final-form": "^5.0.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "@babel/runtime": "^7.26.10"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@types/node": "^25.3.3",
    "daisyui": "^5.5.19",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
